# =====================================================================
# JinwooCrawl - Local Environment Configuration (.env)
# =====================================================================
APP_NAME=JinwooCrawl
APP_ENV=local
PORT=5002
HOST=0.0.0.0

# CORS Allowed Origins
CORS_ORIGINS=http://localhost:5001,http://127.0.0.1:5001,https://crawal.jinwoostream.lol

# MongoDB Database Configuration
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=jinwoo-crawl
MONGODB_COLLECTION=api

# ---------------------------------------------------------------------
# Scraper API Keys & Dummy Credentials (Dynamic, No Hardcoding)
# ---------------------------------------------------------------------

# 1. Instagram Dummy Account (for Instaloader)
# Biarkan kosong jika ingin mode anonim / public profile
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# 2. TikTok Session Key / Cookie (for TikTokApi)
TIKTOK_SESSION_KEY=

# 3. YouTube Data API v3 Key (Google Cloud Console)
YOUTUBE_API_KEY=

# 4. Meta Ad Library API Access Token (Facebook Graph API)
META_ACCESS_TOKEN=
