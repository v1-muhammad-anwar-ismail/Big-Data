# =====================================================================
# JinwooCrawl - Production Server Configuration (.env.server)
# Salin file ini menjadi .env di server production (scrape.jinwoostream.lol)
# =====================================================================
APP_NAME=JinwooCrawl
APP_ENV=production
PORT=5002
HOST=0.0.0.0

# CORS Allowed Origins for Production
CORS_ORIGINS=https://crawal.jinwoostream.lol,http://localhost:5001

# MongoDB Database Configuration (Server)
MONGODB_URI=mongodb://localhost:27017/
MONGODB_DB_NAME=jinwoo-crawl
MONGODB_COLLECTION=api

# ---------------------------------------------------------------------
# Scraper API Keys & Dummy Credentials (Dynamic)
# ---------------------------------------------------------------------

# 1. Instagram Dummy Account
INSTAGRAM_USERNAME=
INSTAGRAM_PASSWORD=

# 2. TikTok Session Key
TIKTOK_SESSION_KEY=

# 3. YouTube Data API v3 Key
YOUTUBE_API_KEY=

# 4. Meta Ad Library API Access Token
META_ACCESS_TOKEN=
